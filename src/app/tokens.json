      "bg-inverse":   { "$value": "{sys.color.bg-inverse}",   "$type": "color" },
      "link":         { "$value": "{sys.color.text-primary}", "$type": "color" },
      "link-current": { "$value": "{sys.color.text-connect}", "$type": "color", "$description": "+ non-color current marker" },
      "focus-ring":   { "$value": "{sys.color.focus-ring}",   "$type": "color" }
    },
    "chart": {
      "axis":  { "$value": "{sys.color.border-strong}",  "$type": "color" },
      "grid":  { "$value": "{sys.color.border}",         "$type": "color" },
      "label": { "$value": "{sys.color.text-secondary}", "$type": "color" },
      "peak":  { "$value": "{sys.color.action-fill}",    "$type": "color", "$description": "gold = earned peak/result apex" }
    }
  }
}
