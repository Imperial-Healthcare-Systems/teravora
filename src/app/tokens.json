      "stack":   { "$value": "{ref.space.4}",  "$type": "dimension", "$description": "vertical rhythm" },
      "gutter":  { "$value": "{ref.space.6}",  "$type": "dimension", "$description": "grid gutter" },
      "section": { "$value": "{ref.space.20}", "$type": "dimension", "$description": "section band" }
    },
    "radius": {
      "control": { "$value": "{ref.radius.md}",   "$type": "dimension" },
      "card":    { "$value": "{ref.radius.lg}",   "$type": "dimension" },
      "pill":    { "$value": "{ref.radius.pill}", "$type": "dimension" }
    },
    "elevation": {
      "card":    { "$value": "{ref.shadow.md}", "$type": "shadow" },
      "popover": { "$value": "{ref.shadow.lg}", "$type": "shadow" },
      "modal":   { "$value": "{ref.shadow.xl}", "$type": "shadow" }
