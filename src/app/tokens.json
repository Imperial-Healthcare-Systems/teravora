      "dataviz-seq-3": { "$value": "{ref.color.neutral-400}", "$type": "color" },
      "dataviz-seq-4": { "$value": "{ref.color.connect}",     "$type": "color" },
      "dataviz-seq-5": { "$value": "{ref.color.anchor}",      "$type": "color" }
    },
