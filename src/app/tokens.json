{
  "$schema": "https://design-tokens.org/draft",
  "$description": "Teravora Design System — DS v0 tokens (design-token / DTCG shape). Layers: ref -> sys -> cmp. Governing source: baselines/brand/v0/brand-baseline.md §5 (CLIENT-AUDITED palette, FROZEN). PENDING-SOURCE-VECTOR CAVEAT: all hexes are the audited RASTER palette; re-confirm against the true source logo vector before PRODUCTION tokens. Type families (Archivo / Source Sans 3) are prototype stand-ins per §5.4. STATUS-COLOR GAP: palette has no dedicated status-red/amber — error/warning mapped within-palette with mandatory non-color encoding; a true status-red is flagged for the vector pass.",
  "$meta": {
    "workstream": "DS",
    "sprint": 3,
    "authority": "propose_only",
    "change_type": "design_tokens",
    "traces_to": "brand@v0 §5.1 client-audited palette",
    "pending_vector_caveat": true,
    "prefix": "trv"
  },

  "ref": {
    "color": {
      "anchor":      { "$value": "#04234D", "$type": "color", "$description": "navy — Ground (15.25 AAA on white)" },
      "eco":         { "$value": "#125A3E", "$type": "color", "$description": "green — Result tier (8.07 AAA on white)" },
      "connect":     { "$value": "#177E84", "$type": "color", "$description": "teal — Connective climb (4.74 AA white; 4.02 on muted → LARGE/ICON/DATAVIZ/FOCUS)" },
      "connect-text": { "$value": "#157075", "$type": "color", "$description": "teal.text — teal WORDS on any light surface (5.72 white / 4.85 on muted #E5EBF2, both AA)" },
      "accent":      { "$value": "#C4912F", "$type": "color", "$description": "gold — Earned peak (2.77 — FILLS/LARGE ONLY)" },
      "accent-text": { "$value": "#7F5C10", "$type": "color", "$description": "gold.text — gold WORDS on light (6.00 AA)" },
      "white":       { "$value": "#FDFDFC", "$type": "color", "$description": "paper — primary ground" },
      "neutral-50":  { "$value": "#F5F7FA", "$type": "color", "$description": "section wash" },
      "neutral-100": { "$value": "#E5EBF2", "$type": "color", "$description": "card backs / fills" },
      "neutral-200": { "$value": "#C5D0DE", "$type": "color", "$description": "1.53 — NON-TEXT ONLY (borders/rules)" },
      "neutral-400": { "$value": "#8592A7", "$type": "color", "$description": "3.09 — LARGE TEXT / UI / ICON / DISABLED only" },
      "neutral-500": { "$value": "#556275", "$type": "color", "$description": "6.09 AA — muted body" },
      "neutral-600": { "$value": "#374355", "$type": "color", "$description": "9.84 AAA — secondary body" },
      "neutral-700": { "$value": "#1B2A40", "$type": "color", "$description": "14.21 AAA — soft primary ink" }
    },
    "fontFamily": {
      "display": { "$value": "Archivo, 'Helvetica Neue', Arial, sans-serif", "$type": "fontFamily", "$description": "engineered grotesk — headings (PROTOTYPE STAND-IN)" },
      "text":    { "$value": "'Source Sans 3', 'Source Sans Pro', system-ui, sans-serif", "$type": "fontFamily", "$description": "humanist sans — body (PROTOTYPE STAND-IN)" },
      "mono":    { "$value": "Archivo, ui-monospace, 'Cascadia Mono', monospace", "$type": "fontFamily", "$description": "tabular figures for metrics/data-viz" }
    },
    "fontSize": {
      "2xs": { "$value": "0.6875rem", "$type": "dimension", "$description": "11px" },
      "xs":  { "$value": "0.75rem",   "$type": "dimension", "$description": "12px" },
      "sm":  { "$value": "0.875rem",  "$type": "dimension", "$description": "14px" },
      "md":  { "$value": "1rem",      "$type": "dimension", "$description": "16px base" },
      "lg":  { "$value": "1.125rem",  "$type": "dimension", "$description": "18px" },
      "xl":  { "$value": "1.375rem",  "$type": "dimension", "$description": "22px (~1.22)" },
      "2xl": { "$value": "1.625rem",  "$type": "dimension", "$description": "26px (~1.18)" },
      "3xl": { "$value": "2rem",      "$type": "dimension", "$description": "32px (~1.23)" },
      "4xl": { "$value": "2.5rem",    "$type": "dimension", "$description": "40px (1.25)" },
      "5xl": { "$value": "3.125rem",  "$type": "dimension", "$description": "50px (1.25)" },
      "6xl": { "$value": "3.875rem",  "$type": "dimension", "$description": "62px (1.24)" }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "none":    { "$value": 1,    "$type": "number", "$description": "metrics — no reflow on count-up" },
      "tight":   { "$value": 1.05, "$type": "number", "$description": "display" },
      "snug":    { "$value": 1.2,  "$type": "number", "$description": "headings" },
      "normal":  { "$value": 1.5,  "$type": "number", "$description": "body" },
      "relaxed": { "$value": 1.65, "$type": "number", "$description": "long-form ESG" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em",     "$type": "dimension" },
      "wide":   { "$value": "0.08em",  "$type": "dimension", "$description": "overline/eyebrow" }
    },
    "space": {
      "0":  { "$value": "0",       "$type": "dimension" },
      "1":  { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "2":  { "$value": "0.5rem",  "$type": "dimension", "$description": "8px" },
      "3":  { "$value": "0.75rem", "$type": "dimension", "$description": "12px" },
      "4":  { "$value": "1rem",    "$type": "dimension", "$description": "16px" },
      "5":  { "$value": "1.25rem", "$type": "dimension", "$description": "20px" },
      "6":  { "$value": "1.5rem",  "$type": "dimension", "$description": "24px" },
      "8":  { "$value": "2rem",    "$type": "dimension", "$description": "32px" },
      "10": { "$value": "2.5rem",  "$type": "dimension", "$description": "40px" },
      "12": { "$value": "3rem",    "$type": "dimension", "$description": "48px" },
      "16": { "$value": "4rem",    "$type": "dimension", "$description": "64px" },
      "20": { "$value": "5rem",    "$type": "dimension", "$description": "80px" },
      "24": { "$value": "6rem",    "$type": "dimension", "$description": "96px" },
      "32": { "$value": "8rem",    "$type": "dimension", "$description": "128px" }
    },
    "radius": {
      "none": { "$value": "0",     "$type": "dimension" },
      "sm":   { "$value": "2px",   "$type": "dimension" },
      "md":   { "$value": "4px",   "$type": "dimension" },
      "lg":   { "$value": "8px",   "$type": "dimension" },
      "xl":   { "$value": "12px",  "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" },
      "full": { "$value": "50%",   "$type": "dimension" }
    },
    "border": {
      "hairline": { "$value": "1px",   "$type": "dimension" },
      "thin":     { "$value": "1.5px", "$type": "dimension" },
      "thick":    { "$value": "2px",   "$type": "dimension" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px rgba(4,35,77,0.06)",   "$type": "shadow", "$description": "navy-tinted" },
      "md": { "$value": "0 2px 8px rgba(4,35,77,0.08)",   "$type": "shadow", "$description": "navy-tinted" },
      "lg": { "$value": "0 8px 24px rgba(4,35,77,0.10)",  "$type": "shadow", "$description": "navy-tinted" },
      "xl": { "$value": "0 16px 48px rgba(4,35,77,0.12)", "$type": "shadow", "$description": "navy-tinted" }
    },
    "z": {
      "base":    { "$value": 0,    "$type": "number" },
      "raised":  { "$value": 10,   "$type": "number" },
      "sticky":  { "$value": 100,  "$type": "number" },
      "overlay": { "$value": 1000, "$type": "number" },
      "modal":   { "$value": 1100, "$type": "number" },
      "toast":   { "$value": 1200, "$type": "number" }
    },
    "breakpoint": {
      "xs": { "$value": "360px",  "$type": "dimension" },
      "sm": { "$value": "768px",  "$type": "dimension" },
      "md": { "$value": "1024px", "$type": "dimension" },
      "lg": { "$value": "1440px", "$type": "dimension" },
      "xl": { "$value": "2560px", "$type": "dimension" }
    },
    "duration": {
      "instant":          { "$value": "0ms",    "$type": "duration" },
      "fast":             { "$value": "150ms",  "$type": "duration", "$description": "micro: hover/toggle" },
      "base":             { "$value": "250ms",  "$type": "duration", "$description": "step/expand" },
      "slow":             { "$value": "400ms",  "$type": "duration", "$description": "MAX DEFAULT — reveals, count-up start, chart grow-in" },
      "immersive-stepin": { "$value": "400ms",  "$type": "duration", "$description": "T2 per step-in reveal (staggered), gate-approved" },
      "immersive-trend":  { "$value": "800ms",  "$type": "duration", "$description": "T2 trend-line draw total, gate-approved" },
      "immersive-count":  { "$value": "1200ms", "$type": "duration", "$description": "T2 count-up; SSR final value = fallback" }
    },
    "ease": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)",   "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)",     "$type": "cubicBezier", "$description": "entrances" },
      "accelerate": { "$value": "cubic-bezier(0.3, 0, 1, 1)",   "$type": "cubicBezier", "$description": "exits" },
      "emphasized": { "$value": "cubic-bezier(0.2, 0, 0, 1.1)", "$type": "cubicBezier", "$description": "the on-brand 'ascent' — subtle overshoot" }
    }
  },

  "sys": {
    "color": {
      "bg-canvas":     { "$value": "{ref.color.white}",       "$type": "color", "$description": "page ground" },
      "bg-subtle":     { "$value": "{ref.color.neutral-50}",  "$type": "color", "$description": "section wash" },
      "bg-muted":      { "$value": "{ref.color.neutral-100}", "$type": "color", "$description": "zebra/fills" },
      "bg-inverse":    { "$value": "{ref.color.anchor}",      "$type": "color", "$description": "GROUND — footers, dark sections" },
      "surface":       { "$value": "{ref.color.white}",       "$type": "color", "$description": "cards" },
      "border":        { "$value": "{ref.color.neutral-200}", "$type": "color", "$description": "1.53 — rules/dividers, NON-TEXT only" },
      "border-strong": { "$value": "{ref.color.neutral-400}", "$type": "color", "$description": "3.09 — UI edges/inputs, non-text/large-UI" },

      "text-primary":   { "$value": "{ref.color.anchor}",      "$type": "color", "$description": "navy 15.25 AAA — headings/primary ink" },
      "text-body":      { "$value": "{ref.color.neutral-700}", "$type": "color", "$description": "14.21 AAA — soft primary body ink" },
      "text-secondary": { "$value": "{ref.color.neutral-600}", "$type": "color", "$description": "9.84 AAA — secondary body" },
      "text-muted":     { "$value": "{ref.color.neutral-500}", "$type": "color", "$description": "6.09 AA — muted/caption (AA floor)" },
      "text-disabled":  { "$value": "{ref.color.neutral-400}", "$type": "color", "$description": "3.09 — LARGE/UI/disabled ONLY, never body" },
      "text-on-inverse":       { "$value": "{ref.color.white}",       "$type": "color", "$description": "15.25 AAA on navy" },
      "text-on-inverse-muted": { "$value": "{ref.color.neutral-100}", "$type": "color", "$description": "soft on navy" },

      "text-result":  { "$value": "{ref.color.eco}",         "$type": "color", "$description": "green 8.07 AAA — result/success words" },
      "text-connect": { "$value": "{ref.color.connect-text}", "$type": "color", "$description": "teal.text 5.72 white / 4.85 muted AA — link/connective words (underline)" },
      "text-accent":  { "$value": "{ref.color.accent-text}", "$type": "color", "$description": "gold.text 6.00 AA — the ONLY compliant gold WORDS on light" },

      "action-fill":       { "$value": "{ref.color.accent}",      "$type": "color", "$description": "gold — earned peak; SCARCE" },
      "action-fill-hover": { "$value": "{ref.color.accent-text}", "$type": "color", "$description": "darker gold hover (navy label stays ≥AA)" },
      "action-on-fill":    { "$value": "{ref.color.anchor}",      "$type": "color", "$description": "NAVY label on gold fill (5.50 AA)" },
      "action-text":       { "$value": "{ref.color.connect-text}", "$type": "color", "$description": "teal.text — link-style/secondary action text (AA on white + muted)" },
      "action-disabled":   { "$value": "{ref.color.neutral-400}", "$type": "color", "$description": "large/UI only" },

      "link":       { "$value": "{ref.color.connect-text}", "$type": "color", "$description": "teal.text 5.72/4.85 AA — MUST underline, never color-alone" },
      "link-hover": { "$value": "{ref.color.anchor}",  "$type": "color" },

      "focus-ring":         { "$value": "{ref.color.connect}", "$type": "color", "$description": "teal on light (≥3:1)" },
      "focus-ring-inverse": { "$value": "{ref.color.accent}",  "$type": "color", "$description": "gold on navy/dark (5.50)" },

      "feedback-success": { "$value": "{ref.color.eco}",         "$type": "color", "$description": "green 8.07 AAA + success icon (non-color mandatory)" },
      "feedback-info":    { "$value": "{ref.color.connect}",     "$type": "color", "$description": "teal 4.74 AA + info icon" },
      "feedback-warning": { "$value": "{ref.color.accent-text}", "$type": "color", "$description": "gold.text 6.00 AA + warning icon" },
      "feedback-error":   { "$value": "{ref.color.neutral-700}", "$type": "color", "$description": "INTERIM (palette has NO status-red) — REQUIRES error icon + 'Error:' text prefix; FLAG true status-red for vector pass" },

      "dataviz-cat-1": { "$value": "{ref.color.anchor}",      "$type": "color", "$description": "navy" },
      "dataviz-cat-2": { "$value": "{ref.color.connect}",     "$type": "color", "$description": "teal" },
      "dataviz-cat-3": { "$value": "{ref.color.eco}",         "$type": "color", "$description": "green" },
      "dataviz-cat-4": { "$value": "{ref.color.accent}",      "$type": "color", "$description": "gold — FILLS/thick marks only, never 1px line" },
      "dataviz-cat-5": { "$value": "{ref.color.neutral-500}", "$type": "color", "$description": "muted" },
      "dataviz-cat-6": { "$value": "{ref.color.neutral-400}", "$type": "color", "$description": "large/UI only" },
      "dataviz-seq-1": { "$value": "{ref.color.neutral-100}", "$type": "color" },
