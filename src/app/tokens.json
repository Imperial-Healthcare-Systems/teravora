      "body-lg": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.lg}", "fontWeight": "{ref.fontWeight.regular}", "lineHeight": "{ref.lineHeight.relaxed}" } },
      "body-md": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.md}", "fontWeight": "{ref.fontWeight.regular}", "lineHeight": "{ref.lineHeight.normal}" } },
      "body-sm": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.sm}", "fontWeight": "{ref.fontWeight.regular}", "lineHeight": "{ref.lineHeight.normal}" } },
      "label":    { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.sm}", "fontWeight": "{ref.fontWeight.semibold}", "lineHeight": "{ref.lineHeight.normal}" } },
      "caption":  { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.xs}", "fontWeight": "{ref.fontWeight.regular}", "lineHeight": "{ref.lineHeight.normal}" } },
      "overline": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.text}", "fontSize": "{ref.fontSize.2xs}", "fontWeight": "{ref.fontWeight.semibold}", "lineHeight": "{ref.lineHeight.normal}", "letterSpacing": "{ref.letterSpacing.wide}", "textTransform": "uppercase" } },
      "metric":   { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.mono}", "fontWeight": "{ref.fontWeight.bold}", "lineHeight": "{ref.lineHeight.none}", "fontVariantNumeric": "tabular-nums lining-nums" }, "$description": "TABULAR figures — T1 count-up, no reflow" }
    },
    "space": {
