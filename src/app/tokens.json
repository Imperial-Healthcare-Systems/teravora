    },
    "input": {
      "bg":           { "$value": "{sys.color.surface}",        "$type": "color" },
      "border":       { "$value": "{sys.color.border-strong}",  "$type": "color" },
      "border-focus": { "$value": "{sys.color.focus-ring}",     "$type": "color" },
      "radius":       { "$value": "{sys.radius.control}",       "$type": "dimension" },
      "label-color":  { "$value": "{sys.color.text-primary}",   "$type": "color" },
      "error-color":  { "$value": "{sys.color.feedback-error}", "$type": "color", "$description": "+ icon + text, never color-alone" }
