      "immersive-count":  { "$value": "{ref.duration.immersive-count}",  "$type": "duration" }
    },
    "ease": {
      "standard":   { "$value": "{ref.ease.standard}",   "$type": "cubicBezier" },
      "decelerate": { "$value": "{ref.ease.decelerate}", "$type": "cubicBezier" },
      "accelerate": { "$value": "{ref.ease.accelerate}", "$type": "cubicBezier" },
      "emphasized": { "$value": "{ref.ease.emphasized}", "$type": "cubicBezier" }
