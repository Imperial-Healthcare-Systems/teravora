  "cmp": {
    "button": {
      "primary-bg":       { "$value": "{sys.color.action-fill}",       "$type": "color", "$description": "gold fill" },
      "primary-bg-hover": { "$value": "{sys.color.action-fill-hover}", "$type": "color" },
