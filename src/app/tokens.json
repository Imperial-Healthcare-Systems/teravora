      "display-lg": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.6xl}", "fontWeight": "{ref.fontWeight.bold}", "lineHeight": "{ref.lineHeight.tight}", "letterSpacing": "{ref.letterSpacing.tight}" } },
      "display-md": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.5xl}", "fontWeight": "{ref.fontWeight.bold}", "lineHeight": "{ref.lineHeight.tight}", "letterSpacing": "{ref.letterSpacing.tight}" } },
      "display-sm": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.4xl}", "fontWeight": "{ref.fontWeight.bold}", "lineHeight": "{ref.lineHeight.tight}", "letterSpacing": "{ref.letterSpacing.tight}" } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.4xl}", "fontWeight": "{ref.fontWeight.bold}", "lineHeight": "{ref.lineHeight.snug}" } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.3xl}", "fontWeight": "{ref.fontWeight.semibold}", "lineHeight": "{ref.lineHeight.snug}" } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{ref.fontFamily.display}", "fontSize": "{ref.fontSize.2xl}", "fontWeight": "{ref.fontWeight.semibold}", "lineHeight": "{ref.lineHeight.snug}" } },
