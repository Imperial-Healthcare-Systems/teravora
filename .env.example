# Template for local/production environment. Copy to .env.local and fill in real
# values. Never commit .env.local — .env.* is gitignored (except this example).

# --- SMTP: proposal form email delivery (/start) --------------------------
# The account the site authenticates with and sends FROM.
SMTP_HOST=mail.teravora.in
SMTP_PORT=587
SMTP_USER=contact@teravora.in
SMTP_PASS=

# Inbox that receives proposal-request notifications (the client).
# Defaults to SMTP_USER when unset.
PROPOSAL_RECIPIENT=contact@teravora.in
