# =============================================================================
# Teravora site — .gitignore
# =============================================================================

# --- Dependencies ---------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output -------------------------------------------------
/.next/
/out/
/build

# --- Caches / generated ---------------------------------------------------
/coverage
*.tsbuildinfo
next-env.d.ts

# --- Environment (secrets — never commit) ---------------------------------
.env
.env.*
!.env.example

# --- Deploy ---------------------------------------------------------------
.vercel

# --- Editor / OS cruft ----------------------------------------------------
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/

# =============================================================================
# Project-specific — not part of the shipped app
# =============================================================================

# Throwaway mockup routes (servable only to be screenshotted for design sign-off)
/src/app/comps/

# Dev tooling: screenshot capture + asset generation (reference local scratch paths)
/scripts/

# Agent / delivery build documentation
/AGENTS.md
/CLAUDE.md
/delivery-evidence.json
